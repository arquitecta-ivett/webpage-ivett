# URL pública definitiva del sitio (sin "/" final). Se usa en canonical, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.ivettdiaz.com

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Medición para campañas (opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# Verificación de Google Search Console (solo el código del meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
